# Fournisseur d'images : "gemini" (réel) ou "mock" (démo sans clé)
IMAGE_PROVIDER=mock

# Clé API Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modèles (modifiables sans toucher au code)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Crédits offerts au démarrage (1 crédit = 1 photo)
STARTING_CREDITS=20

# Dossier de stockage local (base JSON + fichiers)
DATA_DIR=./data
