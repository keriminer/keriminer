# ── Authentification (obligatoire) ──
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'app
BETTER_AUTH_URL=http://localhost:3000

# Connexion Google (optionnelle) : console.cloud.google.com > Identifiants
# URI de redirection : {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Base de données ──
# Vide = Postgres embarqué (PGlite) dans DATA_DIR/pglite, idéal en local.
# Production : postgres://user:pass@host:5432/db (Supabase, Neon, RDS…)
DATABASE_URL=

# ── Génération d'images ──
# "gemini" (réel) ou "mock" (démo sans clé)
IMAGE_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Crédits offerts à l'inscription (1 crédit = 1 photo)
STARTING_CREDITS=20

# Dossier local (fichiers + PGlite)
DATA_DIR=./data
