# ── Authentification (obligatoire) ──
# Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique de l'app
BETTER_AUTH_URL=http://localhost:3000

# Connexion Google (optionnelle) : console.cloud.google.com > Identifiants
# URI de redirection : {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Base de données ──
# Vide = Postgres embarqué (PGlite) dans DATA_DIR/pglite, idéal en local.
# Production : postgres://user:pass@host:5432/db (Supabase, Neon, RDS…)
DATABASE_URL=

# ── Génération d'images ──
# "gemini" (réel) ou "mock" (démo sans clé)
IMAGE_PROVIDER=Réel
GEMINI_API_KEY=AIzaSyDnxuSdw9VGgG6P-pSgWbX2M9NPYoKO97Q
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ── Paiement ──
# URL publique (sert aux URLs de retour et de notification des prestataires). Défaut : BETTER_AUTH_URL
APP_URL=

# PayDunya : Mobile Money + cartes (Mali, Bénin, Côte d'Ivoire, Sénégal, Burkina, Togo, Cameroun…)
# Clés : app.paydunya.com > Intégrez notre API > Configurer une application
PAYDUNYA_MODE=test            # test | live
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=TwinShoot Studio
# Optionnel : restreindre les moyens affichés (ex. orange-money-mali,moov-mali,mtn-benin,moov-benin,card)
PAYDUNYA_CHANNELS=

# Stripe : cartes internationales (diaspora). Nécessite une entité dans un pays supporté par Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=EUR

# Paiement simulé pour développer sans compte marchand (jamais en production)
PAYMENT_MOCK=true

# Crédits offerts à l'inscription (1 crédit = 1 photo)
STARTING_CREDITS=20

# Dossier local (fichiers + PGlite)
DATA_DIR=./data
